# Copy to your private .env only if it does not already exist.
# Never commit .env, pass keys as build arguments, or publish compose config output.
# Gemini is optional for retrieval and required for answer generation.
GEMINI_API_KEY=

# Local Python workflow: leave QDRANT_URL unset to use embedded qdrant_storage/.
# Compose sets QDRANT_URL=http://qdrant:6333 internally; do not publish Qdrant ports.
QDRANT_URL=
# REQUIRED for Compose: set a nonempty random private secret, not a Gemini key.
# The same value authenticates the server, API and migration client.
QDRANT_API_KEY=

# Streamlit local default; Compose overrides this with http://api:8000.
API_BASE_URL=http://127.0.0.1:8000
